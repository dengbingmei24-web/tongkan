# 项目环境变量唯一真源。
# Web 变量复制到 apps/web/.env.local 后再按部署环境修改。

# 信令服务 HTTP 地址。用于创建房间和健康检查。
VITE_SIGNALING_HTTP=http://localhost:8787

# 信令服务 WebSocket 地址。通常与 HTTP 地址使用相同主机。
VITE_SIGNALING_WS=ws://localhost:8787

# 可选：RTCIceServer[] JSON。留空时使用代码内置的公共 STUN。
# TURN 示例格式：[{"urls":"turn:turn.example.com:3478","username":"user","credential":"pass"}]
VITE_RTC_ICE_SERVERS=

# 信令 Worker 允许访问 HTTP API 和 WebSocket 的浏览器来源，逗号分隔。
# 本地默认值与下方一致；生产部署必须设置为实际 HTTPS origin，不要使用 *。
ALLOWED_WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
