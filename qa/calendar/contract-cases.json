    {
      "id": "create-plan-a-b-consistency",
      "title": "A 创建后 B 读取相同计划",
      "category": "crud",
      "coverage": [
        "crud",
        "a-b-consistency"
      ],
      "mode": "sequential",
      "dependsOn": [
        "mutation-input-boundaries-no-revision"
      ],
      "requests": [
        {
          "name": "create-plan",
          "actor": "A",
          "method": "POST",
          "path": "/api/calendar/plans",
          "body": {
            "libraryItemId": "{{LIBRARY_ITEM_1}}",
            "date": "{{CRUD_DATE}}",
            "startTime": null,
            "note": "   ",
            "expectedRevision": "{{BOUNDARY_REVISION}}"
          },
          "expect": {
            "statuses": [
              201
            ],
            "body": {
              "pairId": "{{ACTIVE_PAIR_ID}}",
              "readOnly": false,
              "revision": "{{BOUNDARY_REVISION_PLUS_1}}",
              "plans.0.libraryItemId": "{{LIBRARY_ITEM_1}}",
              "plans.0.date": "{{CRUD_DATE}}",
              "plans.0.startTime": null,
              "plans.0.note": null,
              "plans.0.status": "planned"
            },
            "bodyNonNull": [
              "plans.0.id",
              "plans.0.media.bvid",
              "plans.0.media.url",
              "plans.0.media.title",
              "plans.0.createdBy.id",
              "plans.0.updatedBy.id"
            ],
            "arrayCount": {
              "plans": 1
            }
          },
          "capture": {
            "CRUD_PLAN_ID": "plans.0.id",
            "CRUD_CREATE_REVISION": "revision"
          }
        },
        {
          "name": "partner-reads-created",
          "actor": "B",
          "method": "GET",
          "path": "/api/calendar",
          "query": {
            "date": "{{CRUD_DATE}}"
          },
          "expect": {
            "statuses": [
              200
            ],
            "body": {
              "pairId": "{{ACTIVE_PAIR_ID}}",
              "revision": "{{CRUD_CREATE_REVISION}}",
              "plans.0.id": "{{CRUD_PLAN_ID}}",
              "plans.0.status": "planned"
            },
            "arrayCount": {
              "plans": 1
            }
          }
        }
      ]
    },
    {
      "id": "update-and-complete-plan",
      "title": "改期、备注和完成状态",
      "category": "crud",
      "coverage": [
        "crud",
        "today-filter"
      ],
      "mode": "sequential",
      "dependsOn": [
        "create-plan-a-b-consistency"
      ],
      "requests": [
        {
          "name": "partner-reschedules",
          "actor": "B",
          "method": "PATCH",
          "path": "/api/calendar/plans/{{CRUD_PLAN_ID}}",
          "body": {
            "date": "{{CRUD_UPDATED_DATE}}",
            "startTime": "20:00",
            "note": "  更新后一起看  ",
            "expectedRevision": "{{CRUD_CREATE_REVISION}}"
          },
          "expect": {
            "statuses": [
              200
            ],
            "body": {
              "revision": "{{CRUD_CREATE_REVISION_PLUS_1}}",
              "plans.0.id": "{{CRUD_PLAN_ID}}",
              "plans.0.date": "{{CRUD_UPDATED_DATE}}",
              "plans.0.startTime": "20:00",
              "plans.0.note": "更新后一起看",
              "plans.0.status": "planned"
            }
          },
          "capture": {
            "CRUD_RESCHEDULE_REVISION": "revision"
          }
        },
        {
          "name": "old-date-empty",
          "actor": "A",
          "method": "GET",
          "path": "/api/calendar",
          "query": {
            "date": "{{CRUD_DATE}}"
          },
          "expect": {
            "statuses": [
              200
            ],
            "body": {
              "revision": "{{CRUD_RESCHEDULE_REVISION}}"
            },
            "arrayCount": {
              "plans": 0
            }
          }
        },
        {
          "name": "new-date-has-plan",
          "actor": "A",
          "method": "GET",
          "path": "/api/calendar",
          "query": {
            "date": "{{CRUD_UPDATED_DATE}}"
          },
          "expect": {
            "statuses": [
              200
            ],
            "body": {
              "revision": "{{CRUD_RESCHEDULE_REVISION}}"
            },
            "arrayContains": [
              {
                "path": "plans",
                "match": {
                  "id": "{{CRUD_PLAN_ID}}",
                  "note": "更新后一起看"
                }
              }
            ]
          }
        },
        {
          "name": "creator-completes",
          "actor": "A",
          "method": "PATCH",
          "path": "/api/calendar/plans/{{CRUD_PLAN_ID}}",
          "body": {
            "status": "completed",
            "expectedRevision": "{{CRUD_RESCHEDULE_REVISION}}"
          },
          "expect": {
            "statuses": [
              200
            ],
            "body": {
              "revision": "{{CRUD_RESCHEDULE_REVISION_PLUS_1}}",
              "plans.0.id": "{{CRUD_PLAN_ID}}",
              "plans.0.status": "completed"
            },
            "bodyNonNull": [
              "plans.0.completedAt"
            ]
          },
          "capture": {
            "CRUD_COMPLETED_REVISION": "revision"
          }
        },
        {
          "name": "today-excludes-completed",
          "actor": "B",
          "method": "GET",
          "path": "/api/calendar/today",
          "query": {
            "date": "{{CRUD_UPDATED_DATE}}"
          },
          "expect": {
            "statuses": [
              200
            ],
            "body": {
              "revision": "{{CRUD_COMPLETED_REVISION}}"
            },
            "arrayNotContains": [
              {
                "path": "plans",
                "match": {
                  "id": "{{CRUD_PLAN_ID}}"
                }
              }
            ]
          }
        },
        {
          "name": "date-keeps-completed",
          "actor": "B",
          "method": "GET",
          "path": "/api/calendar",
          "query": {
            "date": "{{CRUD_UPDATED_DATE}}"
          },
          "expect": {
            "statuses": [
              200
            ],
            "body": {
              "revision": "{{CRUD_COMPLETED_REVISION}}"
            },
            "arrayContains": [
              {
                "path": "plans",
                "match": {
                  "id": "{{CRUD_PLAN_ID}}",
                  "status": "completed"
                }
              }
            ]
          }
        }
      ]
    },
