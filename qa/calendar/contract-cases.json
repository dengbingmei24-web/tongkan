{
  "schemaVersion": 1,
  "feature": "TK-004-calendar",
  "openApiContract": "specs/TK-004-calendar/contracts/openapi.yaml",
  "defaultPreviewOrigin": "https://tongkan-account-preview-gateway.pages.dev/account-api",
  "notes": [
    "默认仅执行 ValidateOnly；Live 必须显式启用并使用一次性 SecureString 凭据。",
    "只允许精确 Preview host 或 localhost/127.0.0.1；禁止生产 host。",
    "合同只保存非 secret 夹具名和相对 API 路径，不保存 token、邮箱、邀请 URL 或私有数据。",
    "D1 级联 SQL 仅供审查任务核对定义，runner 永不执行数据库命令。"
  ],
  "errorContract": {
    "400": [
      "INVALID_REQUEST",
      "INVALID_JSON"
    ],
    "401": [
      "AUTH_REQUIRED"
    ],
    "403": [
      "ARCHIVE_FORBIDDEN"
    ],
    "404": [
      "NOT_FOUND",
      "LIBRARY_ITEM_NOT_FOUND",
      "PLAN_NOT_FOUND"
    ],
    "409": [
      "PAIR_REQUIRED",
      "PLAN_ALREADY_EXISTS",
      "CALENDAR_VERSION_CONFLICT"
    ],
    "415": [
      "JSON_REQUIRED"
    ]
  },
  "requiredCoverage": [
    "auth",
    "no-pair",
    "a-b-consistency",
    "query-boundaries",
