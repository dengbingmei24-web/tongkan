        "a-b-consistency"
      ],
      "mode": "sequential",
      "requests": [
        {
          "name": "actor-a-month",
          "actor": "A",
          "method": "GET",
          "path": "/api/calendar",
          "query": {
            "month": "{{CRUD_MONTH}}"
          },
          "expect": {
            "statuses": [
              200
            ],
            "body": {
              "readOnly": false,
              "range.from": "{{CRUD_MONTH_FROM}}",
              "range.to": "{{CRUD_MONTH_TO}}"
            },
            "uniqueBy": [
              {
                "path": "plans",
                "property": "id"
              }
            ]
          },
          "capture": {
            "ACTIVE_PAIR_ID": "pairId",
            "BASE_REVISION": "revision",
            "CRUD_RANGE_FROM": "range.from",
            "CRUD_RANGE_TO": "range.to"
          }
        },
        {
          "name": "actor-b-month",
          "actor": "B",
          "method": "GET",
          "path": "/api/calendar",
          "query": {
            "month": "{{CRUD_MONTH}}"
          },
          "expect": {
            "statuses": [
              200
            ],
            "body": {
              "pairId": "{{ACTIVE_PAIR_ID}}",
              "revision": "{{BASE_REVISION}}",
              "readOnly": false,
              "range.from": "{{CRUD_RANGE_FROM}}",
              "range.to": "{{CRUD_RANGE_TO}}"
            },
            "uniqueBy": [
              {
                "path": "plans",
                "property": "id"
              }
            ]
          }
        }
      ]
    },
