{
  "schemaVersion": 1,
  "feature": "TK-001-unilateral-unbind",
  "openApiContract": "specs/TK-001-unilateral-unbind/contracts/account-unbind.openapi.yaml",
  "defaultPreviewOrigin": "https://account-preview.tongkan-personal.pages.dev/account-api",
  "notes": [
    "每个状态变更用例使用独立 pair，禁止跨用例复用。",
    "Token 和测试密钥只由脚本从环境变量或安全 stdin 读取。",
    "{{NAME}} 只引用非 token 环境变量，脚本不输出解析值。"
  ],
  "environmentVariables": [
    { "name": "TONGKAN_QA_TOKEN_A", "secret": true },
    { "name": "TONGKAN_QA_TOKEN_B", "secret": true },
    { "name": "TONGKAN_QA_TEST_KEY", "secret": true, "optional": true },
    { "name": "TONGKAN_QA_PAIR_SUCCESS", "secret": false },
    { "name": "TONGKAN_QA_PAIR_DELETE", "secret": false },
    { "name": "TONGKAN_QA_PAIR_MIXED", "secret": false },
    { "name": "TONGKAN_QA_PAIR_BOTH_DELETE", "secret": false },
    { "name": "TONGKAN_QA_PAIR_REPEAT", "secret": false },
    { "name": "TONGKAN_QA_PAIR_CONCURRENT", "secret": false },
    { "name": "TONGKAN_QA_OLD_PAIR_ID", "secret": false },
    { "name": "TONGKAN_QA_NEW_PAIR_ID", "secret": false },
    { "name": "TONGKAN_QA_DELETED_PAIR_ID", "secret": false },
    { "name": "TONGKAN_QA_OLD_INVITE_CODE", "secret": false }
  ],
  "cases": [
    {
      "id": "unbind-keep-success",
      "title": "发起方保留并成功解绑",
      "category": "success",
      "requiredEnvironment": ["TONGKAN_QA_PAIR_SUCCESS"],
      "mode": "sequential",
      "requests": [
        { "name": "unbind", "actor": "A", "method": "POST", "path": "/api/pair/unbind", "body": { "pairId": "{{TONGKAN_QA_PAIR_SUCCESS}}", "retention": "keep" }, "expect": { "statuses": [200], "body": { "pairDeleted": false, "archive.retention": "keep", "archive.pairId": "{{TONGKAN_QA_PAIR_SUCCESS}}" } } }
      ]
    },
    {
      "id": "unbind-delete-success",
      "title": "发起方删除自己的访问权",
      "category": "success",
      "requiredEnvironment": ["TONGKAN_QA_PAIR_DELETE"],
      "mode": "sequential",
      "requests": [
        { "name": "unbind", "actor": "A", "method": "POST", "path": "/api/pair/unbind", "body": { "pairId": "{{TONGKAN_QA_PAIR_DELETE}}", "retention": "delete" }, "expect": { "statuses": [200], "body": { "pairDeleted": false, "archive": null } } }
      ]
    },
    {
      "id": "mixed-retention",
      "title": "A 保留、B 删除且决定互不覆盖",
      "category": "mixed-retention",
      "requiredEnvironment": ["TONGKAN_QA_PAIR_MIXED"],
      "mode": "sequential",
      "requests": [
        { "name": "a-unbind-keep", "actor": "A", "method": "POST", "path": "/api/pair/unbind", "body": { "pairId": "{{TONGKAN_QA_PAIR_MIXED}}", "retention": "keep" }, "expect": { "statuses": [200], "body": { "pairDeleted": false, "archive.retention": "keep" } } },
        { "name": "b-delete", "actor": "B", "method": "POST", "path": "/api/pair/archives/{{TONGKAN_QA_PAIR_MIXED}}/retention", "body": { "retention": "delete" }, "expect": { "statuses": [200], "body": { "pairDeleted": false, "archive": null } } }
      ]
    },
    {
      "id": "both-delete",
      "title": "双方删除触发物理清理",
      "category": "both-delete",
      "requiredEnvironment": ["TONGKAN_QA_PAIR_BOTH_DELETE"],
      "mode": "sequential",
      "requests": [
        { "name": "a-unbind-delete", "actor": "A", "method": "POST", "path": "/api/pair/unbind", "body": { "pairId": "{{TONGKAN_QA_PAIR_BOTH_DELETE}}", "retention": "delete" }, "expect": { "statuses": [200], "body": { "pairDeleted": false, "archive": null } } },
        { "name": "b-delete", "actor": "B", "method": "POST", "path": "/api/pair/archives/{{TONGKAN_QA_PAIR_BOTH_DELETE}}/retention", "body": { "retention": "delete" }, "expect": { "statuses": [200], "body": { "pairDeleted": true, "archive": null } } }
      ]
    },
    {
      "id": "same-decision-repeat",
      "title": "同值重试保持幂等",
      "category": "repeat",
      "requiredEnvironment": ["TONGKAN_QA_PAIR_REPEAT"],
      "mode": "sequential",
      "requests": [
        { "name": "a-unbind-keep", "actor": "A", "method": "POST", "path": "/api/pair/unbind", "body": { "pairId": "{{TONGKAN_QA_PAIR_REPEAT}}", "retention": "keep" }, "expect": { "statuses": [200], "body": { "pairDeleted": false, "archive.retention": "keep" } } },
        { "name": "b-keep", "actor": "B", "method": "POST", "path": "/api/pair/archives/{{TONGKAN_QA_PAIR_REPEAT}}/retention", "body": { "retention": "keep" }, "expect": { "statuses": [200], "body": { "pairDeleted": false, "archive.retention": "keep" } } },
        { "name": "b-keep-repeat", "actor": "B", "method": "POST", "path": "/api/pair/archives/{{TONGKAN_QA_PAIR_REPEAT}}/retention", "body": { "retention": "keep" }, "expect": { "statuses": [200], "body": { "pairDeleted": false, "archive.retention": "keep" } } }
      ]
    },
    {
      "id": "different-decision-conflict",
      "title": "异值重试返回稳定冲突码",
      "category": "repeat",
      "requiredEnvironment": ["TONGKAN_QA_PAIR_REPEAT"],
      "mode": "sequential",
      "dependsOn": "same-decision-repeat",
      "requests": [
        { "name": "b-change-to-delete", "actor": "B", "method": "POST", "path": "/api/pair/archives/{{TONGKAN_QA_PAIR_REPEAT}}/retention", "body": { "retention": "delete" }, "expect": { "statuses": [409], "error": "PAIR_RETENTION_FINAL" } }
      ]
    },
    {
      "id": "concurrent-unbind",
      "title": "双方同时解绑只有一次 CAS 成功",
      "category": "concurrent",
      "requiredEnvironment": ["TONGKAN_QA_PAIR_CONCURRENT"],
      "mode": "parallel",
      "requests": [
        { "name": "a-unbind", "actor": "A", "method": "POST", "path": "/api/pair/unbind", "body": { "pairId": "{{TONGKAN_QA_PAIR_CONCURRENT}}", "retention": "keep" }, "expect": { "statuses": [200, 409] } },
        { "name": "b-unbind", "actor": "B", "method": "POST", "path": "/api/pair/unbind", "body": { "pairId": "{{TONGKAN_QA_PAIR_CONCURRENT}}", "retention": "keep" }, "expect": { "statuses": [200, 409] } }
      ],
      "aggregateExpect": { "statusCounts": { "200": 1, "409": 1 }, "errorCounts": { "PAIR_UNBIND_CONFLICT": 1 } }
    },
    {
      "id": "unauthorized-unbind",
      "title": "无 Session Token 时拒绝解绑",
      "category": "unauthorized",
      "requiredEnvironment": ["TONGKAN_QA_PAIR_SUCCESS"],
      "mode": "sequential",
      "requests": [
        { "name": "anonymous-unbind", "actor": "none", "method": "POST", "path": "/api/pair/unbind", "body": { "pairId": "{{TONGKAN_QA_PAIR_SUCCESS}}", "retention": "keep" }, "expect": { "statuses": [401], "error": "AUTH_REQUIRED" } }
      ]
    },
    {
      "id": "invalid-retention",
      "title": "非法保留值返回稳定错误码",
      "category": "stable-error",
      "requiredEnvironment": ["TONGKAN_QA_PAIR_SUCCESS"],
      "mode": "sequential",
      "requests": [
        { "name": "invalid-retention", "actor": "A", "method": "POST", "path": "/api/pair/unbind", "body": { "pairId": "{{TONGKAN_QA_PAIR_SUCCESS}}", "retention": "later" }, "expect": { "statuses": [400], "error": "PAIR_RETENTION_INVALID" } }
      ]
    },
    {
      "id": "late-old-pair-request",
      "title": "旧 pair 请求晚到不能解绑新关系",
      "category": "late-request",
      "requiredEnvironment": ["TONGKAN_QA_OLD_PAIR_ID", "TONGKAN_QA_NEW_PAIR_ID"],
      "mode": "sequential",
      "requests": [
        { "name": "late-old-unbind", "actor": "A", "method": "POST", "path": "/api/pair/unbind", "body": { "pairId": "{{TONGKAN_QA_OLD_PAIR_ID}}", "retention": "delete" }, "expect": { "statuses": [409], "error": "PAIR_UNBIND_CONFLICT" } },
        { "name": "authoritative-refresh", "actor": "A", "method": "GET", "path": "/api/pair", "expect": { "statuses": [200], "body": { "pair.pairId": "{{TONGKAN_QA_NEW_PAIR_ID}}" } } }
      ]
    },
    {
      "id": "old-invite-invalidated",
      "title": "解绑时双方旧邀请码均失效",
      "category": "invite-invalidation",
      "requiredEnvironment": ["TONGKAN_QA_OLD_INVITE_CODE"],
      "mode": "sequential",
      "requests": [
        { "name": "accept-old-invite", "actor": "B", "method": "POST", "path": "/api/pair/invites/{{TONGKAN_QA_OLD_INVITE_CODE}}/accept", "body": {}, "expect": { "statuses": [404], "error": "PAIR_INVITE_NOT_FOUND" } }
      ]
    },
    {
      "id": "retry-after-physical-delete",
      "title": "双方删除后重试返回不泄露关系的 404",
      "category": "delete-retry",
      "requiredEnvironment": ["TONGKAN_QA_DELETED_PAIR_ID"],
      "mode": "sequential",
      "requests": [
        { "name": "retry-retention", "actor": "A", "method": "POST", "path": "/api/pair/archives/{{TONGKAN_QA_DELETED_PAIR_ID}}/retention", "body": { "retention": "delete" }, "expect": { "statuses": [404], "error": "PAIR_ARCHIVE_NOT_FOUND" } }
      ]
    }
  ]
}
